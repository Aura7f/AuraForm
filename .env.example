# ============================================================
# AuraForm — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in your Supabase project values:
#
#   cp .env.example .env
#
# Only variables prefixed with VITE_ are exposed to the client.
# Never put your Supabase service_role key here — the app only
# needs the public anon / publishable key.
#
# If these are left unset (or still point at the placeholder URL),
# the dashboard cannot load forms and shows a configuration error.
# ============================================================

# Your Supabase project URL, found in Supabase Dashboard > Project Settings > API.
# Example: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Public API key. Use either the legacy "anon" key or the newer
# "publishable" key — the app checks ANON first, then PUBLISHABLE.
# Supabase Dashboard > Project Settings > API > Project API keys
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: how long to wait for a Supabase request before failing, in milliseconds.
# Defaults to 15000 (15s). Lower it for snappier errors or raise it for slow
# networks, but keep it at 1000 or above.
VITE_SUPABASE_TIMEOUT_MS=15000
